# FPL bearer token – server-side fallback used when the browser does not send
# an X-Fpl-Token header (e.g. for scripted / server-side access).
# Required only if you do not set the token via the in-app Settings panel.
FPL_BEARER_TOKEN=

# football-data.org API key – enables the Premier League standings widget.
# Leave empty to use stub data.
FOOTBALL_DATA_API_KEY=

# api-football (api-sports.io) key – enables international-break fixtures
# (friendlies, Nations League), preseason club friendlies, and UEFA
# competition (Champions/Europa/Conference League) fixtures & standings.
# Free tier is 100 requests/day; responses are cached for hours, not minutes.
# Get a key at https://dashboard.api-football.com/register
# Leave empty to use stub data.
API_FOOTBALL_KEY=

# Comma-separated list of allowed frontend origins.
# Leave empty (or unset) for local development to allow all origins.
# Example: https://my-app.vercel.app,https://www.my-app.com
ALLOWED_ORIGINS=

# Shared secret for the X-Api-Key header guard on all API endpoints.
# Must match VITE_API_SECRET in the frontend environment.
# Leave empty to disable the guard (open API).
API_SECRET=
