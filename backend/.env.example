# football-data.org API key – enables the Premier League standings widget.
# Leave empty to use stub data.
FOOTBALL_DATA_API_KEY=

# Comma-separated list of allowed frontend origins.
# Leave empty (or unset) for local development to allow all origins.
# Example: https://my-app.vercel.app,https://www.my-app.com
ALLOWED_ORIGINS=

# Shared secret for the X-Api-Key header guard on all API endpoints.
# Must match VITE_API_SECRET in the frontend environment.
# Leave empty to disable the guard (open API).
API_SECRET=
