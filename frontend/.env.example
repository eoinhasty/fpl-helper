# Base URL of the FPL Helper API backend.
# Required when the frontend and backend are hosted on different origins
# (e.g. Vercel frontend + Render backend).
# Leave empty (or omit this file) when they share the same origin — the
# Vite dev proxy handles routing to localhost:8000 automatically.
# Example: https://fpl-helper-api.onrender.com
VITE_API_BASE_URL=

# Sent as the X-Api-Key header on every API request.
# Must match API_SECRET in the backend environment.
# Leave empty if the backend guard is disabled.
VITE_API_SECRET=
